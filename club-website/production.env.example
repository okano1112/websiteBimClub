# Copy to .env on the deployment host. Replace every placeholder; do not commit .env.
DB_USER=bimclub_app
DB_PASSWORD=replace-with-a-long-random-app-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-db-admin-password
DB_NAME=club_database
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_URL=https://replace-with-your-domain.example
SMTP_HOST=replace-with-your-smtp-host
SMTP_PORT=587
SMTP_USER=replace-with-your-smtp-account
SMTP_PASS=replace-with-your-smtp-password
PORT=3000

# Session policy. All replicas must share these values and SESSION_SECRET.
SESSION_IDLE_HOURS=24
SESSION_MAX_DAYS=7
# Direct cloudflared -> app: 1. The load-balanced overlay sets this to 2.
TRUST_PROXY_HOPS=1
